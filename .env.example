# ==============================================================================
# GPP Admin Dashboard - Environment Configuration Template
# قالب متغيرات البيئة للوحة تحكم GPP
# ==============================================================================

# Supabase Project Configuration / إعدادات مشروع سوبابيز
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-jwt-key

# Optional: Gemini API Key / اختياري: مفتاح واجهة برمجة تطبيقات جيميني
VITE_GEMINI_API_KEY=

# Deployment Target Base Path / مسار النشر المستهدف
# Options:
# - 'production'   => builds for https://gpp.ltnet.gov.ly/admin/ (base: /admin/)
# - 'github-pages' => builds for GitHub Pages (base: /ADMIN-GCP-/)
# - '' (empty)     => root domain (base: /)
VITE_DEPLOY_TARGET=production